    assert abs(_cpu_percent(48_000_000, 1.0, (125, 3)) - 200.0) < 0.1   # two cores
    assert abs(_cpu_percent(24_000_000, 2.0, (125, 3)) - 50.0) < 0.1    # half as busy
    assert _cpu_percent(0, 1.0, (125, 3)) == 0.0

    # per-process CPU + memory with NO sudo, via libproc: only the IMPACT column
