    assert [r["pid"] for r in sort_rows(trows, "cpu_pct", reverse=False)] == [987, 1258, 11]
    by_mem = sort_rows(trows, "rss_mb")
    assert [r["pid"] for r in by_mem] == [11, 987, 1258], "unknown memory sorts last"
    assert [r["pid"] for r in sort_rows(trows, "rss_mb", reverse=False)] == [987, 11, 1258], \
