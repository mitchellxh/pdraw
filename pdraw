# ── SMC engine: read AppleSMC 'flt ' keys directly over IOKit, no sudo ──────────
# Two-call handshake per key (READ_KEYINFO for size/type, then READ_BYTES), the
# same protocol istats/smckit use. argtypes/restype are mandatory: without them
# ctypes assumes 32-bit int and truncates 64-bit pointers → segfault.
_KERNEL_INDEX_SMC = 2
_CMD_READ_BYTES = 5
_CMD_READ_KEYINFO = 9


class _Vers(ctypes.Structure):
    _fields_ = [("major", ctypes.c_uint8), ("minor", ctypes.c_uint8),
                ("build", ctypes.c_uint8), ("reserved", ctypes.c_uint8),
                ("release", ctypes.c_uint16)]


class _PLimit(ctypes.Structure):
    _fields_ = [("version", ctypes.c_uint16), ("length", ctypes.c_uint16),
                ("cpuPLimit", ctypes.c_uint32), ("gpuPLimit", ctypes.c_uint32),
                ("memPLimit", ctypes.c_uint32)]


class _KeyInfo(ctypes.Structure):
    _fields_ = [("dataSize", ctypes.c_uint32), ("dataType", ctypes.c_uint32),
                ("dataAttributes", ctypes.c_uint8)]


class _KeyData(ctypes.Structure):
    _fields_ = [("key", ctypes.c_uint32), ("vers", _Vers), ("pLimitData", _PLimit),
                ("keyInfo", _KeyInfo), ("result", ctypes.c_uint8),
                ("status", ctypes.c_uint8), ("data8", ctypes.c_uint8),
                ("data32", ctypes.c_uint32), ("bytes", ctypes.c_uint8 * 32)]


def _fourcc(s):
    return struct.unpack(">I", s.encode())[0]


class SMC:
    def __init__(self):
        io = ctypes.CDLL(ctypes.util.find_library("IOKit"))
        libc = ctypes.CDLL(ctypes.util.find_library("c"))
        cvp, cu32, csz = ctypes.c_void_p, ctypes.c_uint32, ctypes.c_size_t
        io.IOServiceMatching.restype = cvp
        io.IOServiceMatching.argtypes = [ctypes.c_char_p]
        io.IOServiceGetMatchingService.restype = cu32
        io.IOServiceGetMatchingService.argtypes = [cu32, cvp]
        io.IOServiceOpen.restype = ctypes.c_int
        io.IOServiceOpen.argtypes = [cu32, cu32, cu32, ctypes.POINTER(cu32)]
        io.IOConnectCallStructMethod.restype = ctypes.c_int
        io.IOConnectCallStructMethod.argtypes = [cu32, cu32, cvp, csz, cvp,
                                                 ctypes.POINTER(csz)]
        libc.mach_task_self.restype = cu32
        self._io = io
        svc = io.IOServiceGetMatchingService(0, io.IOServiceMatching(b"AppleSMC"))
        if not svc:
            raise OSError("AppleSMC service not found")
        self.conn = cu32()
        r = io.IOServiceOpen(svc, libc.mach_task_self(), 0, ctypes.byref(self.conn))
        if r != 0:
            raise OSError(f"IOServiceOpen failed: {r:#x}")

    def _call(self, inp):
        out = _KeyData()
        osz = ctypes.c_size_t(ctypes.sizeof(_KeyData))
        r = self._io.IOConnectCallStructMethod(
            self.conn, _KERNEL_INDEX_SMC, ctypes.byref(inp), ctypes.sizeof(_KeyData),
            ctypes.byref(out), ctypes.byref(osz))
        if r != 0:
            raise OSError(f"SMC call failed: {r:#x}")
        return out

    def read_flt(self, key):
        inp = _KeyData(); inp.key = _fourcc(key); inp.data8 = _CMD_READ_KEYINFO
        info = self._call(inp)
        size, dtype = info.keyInfo.dataSize, info.keyInfo.dataType
        inp = _KeyData(); inp.key = _fourcc(key)
        inp.keyInfo.dataSize = size; inp.data8 = _CMD_READ_BYTES
        raw = bytes(self._call(inp).bytes[:size])
        if struct.pack(">I", dtype) != b"flt ":
            raise ValueError(f"{key}: type {struct.pack('>I', dtype)!r}, not 'flt '")
        return struct.unpack("<f", raw[:4])[0]


# ── data acquisition ────────────────────────────────────────────────────────────
def ioreg_battery():
    """Battery + adapter contract + PD offer menu from ioreg AppleSmartBattery."""
    out = subprocess.run(["ioreg", "-a", "-r", "-n", "AppleSmartBattery"],
                         capture_output=True, timeout=10).stdout
    d = plistlib.loads(out)[0]
    ad = d.get("AdapterDetails", {})
    tr = d.get("TimeRemaining")
    design = d.get("DesignCapacity") or 0
    return {
        "battery": {
            "percent": d.get("CurrentCapacity", 0),
            "amperage_ma": d.get("Amperage", 0),      # signed: <0 discharging
            "voltage_mv": d.get("Voltage", 0),
            "temperature_c": d.get("Temperature", 0) / 100,
            "health_pct": round(100 * d.get("AppleRawMaxCapacity", 0) / design) if design else 0,
            "cycle_count": d.get("CycleCount", "?"),
            "time_remaining_min": tr if tr and tr < 65535 else None,
        },
        "adapter": {
            "connected": bool(d.get("ExternalConnected")),
            "watts": ad.get("Watts", 0),
            "voltage_mv": ad.get("AdapterVoltage", 0),
            "current_ma": ad.get("Current", 0),
            "name": ad.get("Description") or ad.get("Name") or "",
            "menu": [(m.get("MaxVoltage", 0) / 1000, m.get("MaxCurrent", 0) / 1000)
                     for m in ad.get("UsbHvcMenu", [])],
        },
    }


def _gpu_from_stats(ps):
    """Pure parse of IOAccelerator PerformanceStatistics; None if unusable.

    'In use system memory' is GPU memory, not system memory — verified by
    correlation on this hardware 2026-09-07: it tracked 1.8 -> 31.2 GB as
    utilization went 40% -> 99% while system RAM stayed flat at ~28 GB.
    """
    util, mem = ps.get("Device Utilization %"), ps.get("In use system memory")
    if util is None or mem is None:
        return None
    return {"util_pct": float(util), "mem_inuse_gb": mem / 2**30}


def ioreg_gpu():
    """Global GPU utilization + memory (no sudo). None -> group omitted entirely."""
    try:
        out = subprocess.run(["ioreg", "-a", "-r", "-c", "IOAccelerator"],
                             capture_output=True, timeout=10).stdout
        for node in plistlib.loads(out) or []:
            g = _gpu_from_stats(node.get("PerformanceStatistics") or {})
            if g:
                return g
    except Exception:  # no accelerator / timeout / bad plist — degrade, never fail
        return None
    return None


# ── host CPU / RAM: mach host_statistics over ctypes ────────────────────────────
# Same ctypes idiom as the SMC engine above, and far cheaper than forking
# `vm_stat`/`ps` each frame (measured 2026-09-07: mach call unmeasurable vs an
# ~18 ms ioreg fork). argtypes are mandatory here for the same 64-bit reason.
_HOST_CPU_LOAD_INFO, _HOST_VM_INFO64, _PAGE = 3, 4, 16384
_U32, _U64 = ctypes.c_uint32, ctypes.c_uint64


class _CpuLoad(ctypes.Structure):
    _fields_ = [("ticks", _U32 * 4)]  # user, system, idle, nice


class _VMStat64(ctypes.Structure):    # vm_statistics64; full struct so the
    _pack_ = 8                        # kernel's count check matches (38 u32s)
    _fields_ = [("free", _U32), ("active", _U32), ("inactive", _U32), ("wire", _U32),
                ("zero_fill", _U64), ("reactivations", _U64), ("pageins", _U64),
                ("pageouts", _U64), ("faults", _U64), ("cow_faults", _U64),
                ("lookups", _U64), ("hits", _U64), ("purges", _U64),
                ("purgeable", _U32), ("speculative", _U32), ("decompressions", _U64),
                ("compressions", _U64), ("swapins", _U64), ("swapouts", _U64),
                ("compressor", _U32), ("throttled", _U32), ("external", _U32),
                ("internal", _U32), ("uncompressed_in_compressor", _U64)]


def _ram_gb(active, wire, comp, page=_PAGE):
    """Used RAM = active + wired + compressed pages. Matches `vm_stat` exactly.

    Note wired includes GPU allocations on unified memory, so this figure and
    `gpu_mem` overlap heavily rather than being independent quantities.
    """
    return (active + wire + comp) * page / 2**30


def cpu_pct_from_ticks(prev, cur):
    """Busy % across one interval between two HOST_CPU_LOAD_INFO samples."""
    d = [b - a for a, b in zip(prev, cur)]
    total = sum(d)
    return 100.0 * (d[0] + d[1] + d[3]) / total if total > 0 else 0.0  # +nice


# ── powermetrics stream: NUL-framed plists ──────────────────────────────────────
class PlistFrames:
    """Reassembles a `powermetrics --format plist` byte stream into whole plists.

    Frames are NUL-separated, and a read from a pipe lands wherever it lands, so
    a frame split mid-XML is routine. Partial tails are held until terminated.
    """

    def __init__(self):
        self._buf = b""
        self.dropped = 0        # corrupt frames seen; surfaced rather than hidden

    _END = b"</plist>"

    def feed(self, chunk):
        """Parsed dicts for every frame this chunk completed (possibly none)."""
        self._buf += chunk
        out = []
        while b"\x00" in self._buf:
            raw, self._buf = self._buf.split(b"\x00", 1)
            self._emit(raw, out)
        # powermetrics writes no NUL after its final frame, so a NUL-only reader
        # loses it (verified against a captured fixture: 1 of 2 frames emitted).
        # A buffered tail closed by </plist> is complete — take it now.
        if self._buf.rstrip().endswith(self._END):
            self._emit(self._buf, out)
            self._buf = b""
        return out

    def _emit(self, raw, out):
        if not raw.strip():
            return
        try:
            out.append(plistlib.loads(raw))
        except (plistlib.InvalidFileException, ExpatError):
            self.dropped += 1   # narrow: a bug in our own code still surfaces


# ── keyboard: navigation for the procs view ─────────────────────────────────────
# Arrow keys arrive as ESC [ A/B, and one read can carry several keypresses, so
# the buffer is consumed as a sequence rather than a single character.
_KEYS = {"q": "quit", "j": "down", "k": "up", "g": "top", "G": "bottom",
         " ": "pgdn", "b": "pgup", "r": "reverse",
         "c": "sort_cpu", "e": "sort_energy", "m": "sort_mem",
         "p": "sort_pid", "n": "sort_name"}
SORT_KEYS = {"sort_cpu": "cpu_pct", "sort_energy": "energy", "sort_mem": "rss_mb",
             "sort_pid": "pid", "sort_name": "name"}
_ARROWS = {"A": "up", "B": "down", "5": "pgup", "6": "pgdn"}


def parse_keys(buf):
    """Actions for a raw key buffer; unknown keys are ignored, never fatal."""
    out, i = [], 0
    while i < len(buf):
        if buf[i] == "\x1b" and buf[i + 1:i + 2] == "[":
            out.append(_ARROWS.get(buf[i + 2:i + 3]))
            i += 3
            continue
        out.append(_KEYS.get(buf[i]))
        i += 1
    return [a for a in out if a]


def scroll_clamp(off, action, rows, view):
    """New scroll offset, clamped so the view never runs off either end."""
    top = max(0, rows - view)
    step = {"down": 1, "up": -1, "pgdn": view, "pgup": -view}.get(action)
    if step is not None:
        off += step
    elif action == "top":
        off = 0
    elif action == "bottom":
        off = top
    return max(0, min(off, top))


class KeyReader:
    """Non-blocking single-key reads from the tty, restoring termios on exit."""

    def __init__(self):
        self.fd = sys.stdin.fileno()
        self.saved = termios.tcgetattr(self.fd)
        tty.setcbreak(self.fd)

    def pending(self):
        """Everything typed since the last call, as one string (often empty)."""
        buf = ""
        while select.select([self.fd], [], [], 0)[0]:
            chunk = os.read(self.fd, 64)
            if not chunk:
                break
            buf += chunk.decode("utf-8", "replace")
        return buf

    def restore(self):
        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)


def sudo_passwordless(argv):
    """True if this exact command may run as root with no prompt.

    `sudo -n -l CMD ARGS...` asks that question without ever prompting, so it
    is safe to call before deciding whether to bother the user at all.
    """
    return subprocess.run(["sudo", "-n", "-l", *argv],
                          capture_output=True).returncode == 0


def sudo_prime(argv):
    """Ensure we can run `argv` as root. Returns True if stderr can be silenced.

    Prompts only when it must: a NOPASSWD sudoers rule or a still-valid cached
    credential means `pdraw procs` starts without interrupting anyone. When a
    prompt IS needed it happens here, on the real tty, before the alt-screen --
    and silencing the child's stderr afterwards is what keeps powermetrics'
    `proc_pidpath ... failed` chatter off the display.
    """
    if sudo_passwordless(argv):
        return True
    print("pdraw: per-process energy needs powermetrics as root; sudo may prompt.")
    subprocess.run(["sudo", "-v"])          # inherits the tty; prompts if needed
    return subprocess.run(["sudo", "-n", "true"],
                          capture_output=True).returncode == 0


class PowerMetrics:
    """Long-lived `sudo powermetrics` stream — one child, no per-tick fork.

    powermetrics costs real CPU while sampling (measured ~66 ms/s of CPU in its
    own task list), so it is spawned once and read incrementally rather than
    re-run each tick. stdin/stderr are inherited so sudo can prompt on the tty.
    """

    # Fixed, fully-literal argv: a NOPASSWD sudoers rule can then pin every
    # argument, which matters because `powermetrics -o FILE` writes as root and
    # an unpinned rule would be a privilege-escalation hole.
    BIN = "/usr/bin/powermetrics"
    ARGS = ("--samplers", "tasks", "--show-process-energy",
            "-f", "plist", "-b", "1", "-n", "-1", "-i", "1000")

    @classmethod
    def argv(cls):
        return [cls.BIN, *cls.ARGS]

    def __init__(self, stream=None, quiet=True):
        self._frames, self.latest, self.proc = PlistFrames(), None, None
        if stream is not None:          # injected by tests; no child, no sudo
            self._fd = stream
            return
        self.proc = subprocess.Popen(
            ["sudo", *self.argv()],
            stdout=subprocess.PIPE,
            # quiet only once the credential is cached, else a prompt would be
            # invisible; powermetrics chatters on stderr the whole run otherwise
            stderr=subprocess.DEVNULL if quiet else None)
        self._fd = self.proc.stdout
        os.set_blocking(self._fd.fileno(), False)   # never stall the render loop

    def poll(self):
        """Newest complete frame; the previous one if this tick brought none."""
        try:
            chunk = self._fd.read()
        except (BlockingIOError, ValueError):
            chunk = None
        for frame in self._frames.feed(chunk or b""):
            self.latest = frame         # a live view only wants the newest
        return self.latest

    def close(self):
        """Stop the child. Returns surviving pids, or None if it went cleanly.

        powermetrics documents SIGTERM as "stop sampling and exit". It runs as
        root via sudo, so if it outlives us we cannot kill it ourselves — report
        the survivors instead of leaving them sampling silently.
        """
        if not self.proc:
            return None
        self.proc.terminate()
        try:
            self.proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            self.proc.kill()
        left = subprocess.run(["pgrep", "-x", "powermetrics"],
                              capture_output=True, text=True).stdout.split()
        return left or None


# Column set: (header, width, row key, formatter). Units live in the header so
# they are stated once instead of repeated on every row.
_COLS = (("PID", 7, "pid", lambda v: f"{v:d}"),
         ("PROCESS", 0, "name", None),                       # 0 = the flex column
         ("CPU%", 8, "cpu_pct", lambda v: f"{v:.1f}"),
         ("IMPACT/s", 10, "energy", lambda v: f"{v:.1f}"),
         ("MEM MB", 9, "rss_mb", lambda v: f"{v:.0f}"))


def next_sort(key, reverse, action):
    """Same column -> flip direction. A different column -> start descending,
    since the first thing anyone wants from a new metric is its biggest values."""
    want = SORT_KEYS[action]
    return (want, not reverse) if want == key else (want, True)


# 256-colour ramp, cool grey through to hot red.
_RAMP = (238, 242, 246, 250, 254, 227, 221, 215, 209, 203)


def _heat(frac):
    """Colour for a position in 0..1 along the cool-to-hot ramp."""
    f = max(0.0, min(1.0, frac))
    return f"38;5;{_RAMP[min(int(f * len(_RAMP)), len(_RAMP) - 1)]}"


def sort_rows(rows, key="energy", reverse=True):
    """Sort by any column. Rows whose value is unreadable always sort last,
    in both directions -- an unknown is not a small value."""
    known = [r for r in rows if r.get(key) is not None]
    unknown = [r for r in rows if r.get(key) is None]
    if key == "name":
        known.sort(key=lambda r: r["name"].lower(), reverse=reverse)
    else:
        known.sort(key=lambda r: r[key], reverse=reverse)
    return known + unknown


def proc_table(rows, sort_key="energy", reverse=True, name_w=34, show_energy=True):
    """Process table. The active sort column is marked so the view says how it
    is ordered rather than leaving the reader to guess."""
    cols = [col for col in _COLS if col[2] != "energy" or show_energy]
    mark = "▼" if reverse else "▲"
    widths = [w or name_w for _, w, _, _ in cols]
    heads = [lbl + (mark if key == sort_key else "") for lbl, _, key, _ in cols]
    head = (f"     {heads[0]:>{widths[0]}}  {heads[1]:<{widths[1]}}"
            + "".join(f"{h:>{w}}" for h, w in zip(heads[2:], widths[2:])))
    out = [c("90", head), "     " + c("90", "─" * (len(head) - 5))]
    # Colour by RANK among the visible rows, not by share of the maximum. Process
    # load is skewed enough that one busy process pins the scale and flattens
    # everyone else into a single shade; rank always gradates. The numbers carry
    # magnitude -- colour is a visual index for ordering the eye.
    order = sorted(range(len(rows)),
                   key=lambda i: (rows[i].get(sort_key) is not None,
                                  rows[i].get(sort_key) or 0))
    rank = {i: pos for pos, i in enumerate(order)}
    span = max(len(rows) - 1, 1)
    for i, r in enumerate(rows):
        tail = "".join(f"{('—' if r.get(k) is None else fmt(r[k])):>{w}}"
                       for (_, _, k, fmt), w in zip(cols[2:], widths[2:]))
        shade = _heat(rank[i] / span)
        pid_cell = f"{r['pid']:>{widths[0]}}"
        out.append(f"     {c('90', pid_cell)}  "
                   + c(shade, f"{r['name'][:name_w]:<{widths[1]}}" + tail))
    return out


# ── per-process memory: proc_pidinfo over ctypes ────────────────────────────────
# Unlike task_for_pid (denied even for same-user processes), proc_pidinfo reads
# any process we own: measured 200/200 of this user's, 0/200 of other users'.
# 0.0015 ms a call, so no fork and no cache needed.
_PROC_PIDTASKINFO = 4


class _ProcTaskInfo(ctypes.Structure):
    _fields_ = ([("pti_virtual_size", _U64), ("pti_resident_size", _U64),
                 ("pti_total_user", _U64), ("pti_total_system", _U64),
                 ("pti_threads_user", _U64), ("pti_threads_system", _U64)] +
                [(n, ctypes.c_int32) for n in
                 ("policy", "faults", "pageins", "cow_faults", "messages_sent",
                  "messages_received", "syscalls_mach", "syscalls_unix", "csw",
                  "threadnum", "numrunning", "priority")])


_LIBPROC = ctypes.CDLL(ctypes.util.find_library("c"))
_LIBPROC.proc_pidinfo.argtypes = [ctypes.c_int, ctypes.c_int, _U64,
                                  ctypes.c_void_p, ctypes.c_int]


_PROC_ALL_PIDS = 1
_LIBPROC.proc_listpids.argtypes = [_U32, _U32, ctypes.c_void_p, ctypes.c_int]
_LIBPROC.proc_name.argtypes = [ctypes.c_int, ctypes.c_char_p, _U32]


def list_pids():
    """Every pid on the machine (no sudo). Reading them is a separate question."""
    need = _LIBPROC.proc_listpids(_PROC_ALL_PIDS, 0, None, 0)
    if need <= 0:
        return []
    buf = (ctypes.c_int32 * (need // 4))()
    got = _LIBPROC.proc_listpids(_PROC_ALL_PIDS, 0, buf, need)
    return [p for p in buf[:max(got, 0) // 4] if p > 0]


def proc_name(pid):
    buf = ctypes.create_string_buffer(256)
    if _LIBPROC.proc_name(pid, buf, 256) > 0:
        return buf.value.decode("utf-8", "replace")
    return None


def _task_info(pid):
    info = _ProcTaskInfo()
    size = ctypes.sizeof(_ProcTaskInfo)
    ok = _LIBPROC.proc_pidinfo(pid, _PROC_PIDTASKINFO, 0, ctypes.byref(info), size)
    return info if ok == size else None


class _MachTimebase(ctypes.Structure):
    _fields_ = [("numer", _U32), ("denom", _U32)]


def _mach_timebase():
    """(numer, denom) for mach ticks -> nanoseconds. 125/3 on Apple Silicon."""
    tb = _MachTimebase()
    try:
        _LIBPROC.mach_timebase_info(ctypes.byref(tb))
    except (AttributeError, OSError):   # symbol absent -> assume ticks are ns
        return (1, 1)
    return (tb.numer or 1, tb.denom or 1)


TIMEBASE = _mach_timebase()


def _ticks_to_ms(ticks, numer, denom):
    """Mach absolute time units -> milliseconds.

    proc_pidinfo reports CPU time in mach ticks, NOT nanoseconds. On Apple
    Silicon a tick is 125/3 ns, so dividing by 1e6 as if it were nanoseconds
    under-reports CPU by ~42x -- a process pinning one core reads 24 ms/s
    instead of 1000.
    """
    return ticks * numer / denom / 1e6


def _cpu_percent(ticks, dt, timebase=None):
    """CPU as a percentage of ONE core over `dt` seconds.

    top's and Activity Monitor's convention: 100% is one core saturated, and a
    threaded process legitimately exceeds it (this machine has 18 cores, so the
    ceiling is 1800%). Chosen over powermetrics' ms/s because it needs no
    explanation -- 1000 ms/s meaning "one core" is not self-evident.
    """
    numer, denom = timebase or TIMEBASE
    return _ticks_to_ms(ticks, numer, denom) / dt / 10.0


class Processes:
    """Per-process CPU and memory with NO sudo, via libproc.

    proc_pidinfo reads every process we own (measured 379 of 624 on this
    machine); the rest belong to other users and are simply not listed, because
    a row whose numbers we cannot read is not information.

    CPU is a delta of cumulative task time, so the first sample is a baseline.
    """

    def __init__(self):
        self._prev, self._t = {}, time.monotonic()

    def sample(self):
        now = time.monotonic()
        dt = max(now - self._t, 1e-6)
        cur, rows = {}, []
        for pid in list_pids():
            info = _task_info(pid)
            if info is None:
                continue
            ticks = info.pti_total_user + info.pti_total_system
            cur[pid] = ticks
            was = self._prev.get(pid)
            rows.append({
                "pid": pid,
                "name": proc_name(pid) or "?",
                "cpu_pct": _cpu_percent(ticks - was, dt) if was is not None else 0.0,
                "rss_mb": info.pti_resident_size / 2**20,
                "energy": None,          # only powermetrics-as-root can fill this
            })
        self._prev, self._t = cur, now
        return rows


def merge_energy(rows, pm_frame):
    """Fold powermetrics energy impact into libproc rows, matched on pid."""
    if not pm_frame:
        return rows
    by_pid = {t["pid"]: t.get("energy_impact_per_s", 0.0)
              for t in (pm_frame.get("tasks") or []) if t.get("pid", -1) >= 0}
    for r in rows:
        r["energy"] = by_pid.get(r["pid"])
    return rows


def host_or_none():
    """Host(), or None if mach is unavailable — the system group then never appears."""
    try:
        return Host()
    except Exception:  # optional data source: a monitor must not die without it
        return None


class Host:
    """CPU% and RAM over mach. CPU is a delta, so the first read is a baseline."""

    def __init__(self):
        libc = ctypes.CDLL(ctypes.util.find_library("c"))
        libc.mach_host_self.restype = _U32
        for fn in (libc.host_statistics, libc.host_statistics64):
            fn.argtypes = [_U32, ctypes.c_int, ctypes.c_void_p, ctypes.POINTER(_U32)]
        libc.sysctlbyname.argtypes = [ctypes.c_char_p, ctypes.c_void_p,
                                      ctypes.POINTER(ctypes.c_size_t), ctypes.c_void_p,
                                      ctypes.c_size_t]
        self._libc, self._port = libc, libc.mach_host_self()
        mem, sz = _U64(), ctypes.c_size_t(8)
        libc.sysctlbyname(b"hw.memsize", ctypes.byref(mem), ctypes.byref(sz), None, 0)
        self.total_gb = mem.value / 2**30
        self._prev = self._ticks()

    def _ticks(self):
        b, n = _CpuLoad(), _U32(4)
        self._libc.host_statistics(self._port, _HOST_CPU_LOAD_INFO,
                                   ctypes.byref(b), ctypes.byref(n))
        return list(b.ticks)

    def read(self):
        cur = self._ticks()
        cpu, self._prev = cpu_pct_from_ticks(self._prev, cur), cur
        v, n = _VMStat64(), _U32(ctypes.sizeof(_VMStat64) // 4)
        self._libc.host_statistics64(self._port, _HOST_VM_INFO64,
                                     ctypes.byref(v), ctypes.byref(n))
        return {"cpu_pct": cpu, "ram_gb": _ram_gb(v.active, v.wire, v.compressor)}


BATTERY_POLL_S = 5.0   # AppleSmartBattery refreshes every ~35-43s (measured on this
                       # hardware 2026-09-07), so per-tick polling re-forked ioreg at
                       # ~18ms a fork for no new data. 5s not 2s: at -i 2000 a 2s
                       # period re-read on every tick (291/291), leaving it inert.


class BatteryCache:
    """Last ioreg_battery() result, re-read only every `period` seconds.

    Also reports the reading's age, so a log line can say how old its battery
    figure is instead of silently implying it is as fresh as the watt rails.
    """

    def __init__(self, read=None, clock=time.monotonic, period=BATTERY_POLL_S):
        self._read = read or ioreg_battery
        self._clock, self._period = clock, period
        self._val, self._at = None, 0.0

    def get(self):
        """(battery sample, age in seconds since it was actually read)."""
        now = self._clock()
        if self._val is None or now - self._at >= self._period:
            self._val, self._at = self._read(), now
        return self._val, now - self._at


def battery_flow_w(bat):
    # positive = charging. ioreg amperage is signed and matches the true direction.
    return bat.get("amperage_ma", 0.0) * bat.get("voltage_mv", 0.0) / 1e6


def read_sample(smc, host=None, bat_cache=None):
    p = smc.read_flt
    if bat_cache:                 # shallow copy: read_sample only adds top-level
        held, age = bat_cache.get()   # keys, so the cached nested dicts are safe
        s = dict(held)
        s["battery_age_s"] = round(age, 2)
    else:
        s = ioreg_battery()
    connected = s["adapter"]["connected"]
    s["sys_power_w"] = p("PSTR")                       # the pull
    s["adapter_power_w"] = p("PDTR") if connected else 0.0  # delivering
    s["compute_w"] = p("PHPS")                          # CPU/SoC compute rail
    s["battery_flow_w"] = battery_flow_w(s["battery"])
    gpu = ioreg_gpu()
    if gpu:                       # absent accelerator -> key omitted, group dropped
        s["gpu"] = gpu
    if host:
        s["host"] = host.read()
        s["ram_total_gb"] = host.total_gb
    return s


def lane_values(s):
    """Lane name -> value. GPU/host lanes appear only when the sample has them:
    a missing rail must vanish, not read 0.0 and draw a flat line that isn't real."""
    v = {"draw": s["sys_power_w"], "charger": s["adapter_power_w"],
         "compute": s["compute_w"], "battery": s["battery_flow_w"]}
    if s.get("gpu"):
        v["gpu"], v["gpu_mem"] = s["gpu"]["util_pct"], s["gpu"]["mem_inuse_gb"]
    if s.get("host"):
        v["cpu"], v["ram"] = s["host"]["cpu_pct"], s["host"]["ram_gb"]
    return v


def active_groups(s):
    """Groups this sample can actually fill; the rest are dropped entirely."""
    have = lane_values(s)
    return tuple((name, lanes) for name, lanes in GROUPS
                 if all(lane in have for lane in lanes))


# Bounded metrics get fixed scales. Auto-scaling a percentage is actively
# misleading — a GPU steady at 40% would fill its panel and read as pegged.
# Only unbounded quantities (watts) scale to the data they see.
PCT_LANES = ("gpu", "cpu")
MEM_LANES = ("gpu_mem", "ram")


def lane_scale(lane, vals, hi_floor=None, total_gb=0.0):
    """(y_min, y_max) for one lane: fixed for bounded metrics, dynamic for watts."""
    if lane in PCT_LANES:
        return 0.0, 100.0
    if lane in MEM_LANES:
        return 0.0, float(total_gb or 1.0)
    lo = min(0.0, min(vals))                       # 0-anchored, padded, >=2 tall
    hi = max(max(vals), hi_floor or 0) * 1.05 + 1
    return lo, max(hi, lo + 2)


# ── snapshot ─────────────────────────────────────────────────────────────────────
# Verdict-first glance view: the headline IS the story — are we gaining or losing
# ground, by how much. `battery_flow_w` is the true signed net (it leads); the
# ledger below shows *why* (draw vs what the charger delivers, both under rated),
# so the reader sees a single deficit number, not two. Bars share one scale.
_EIGHTHS = " ▏▎▍▌▋▊▉"  # 0..7 eighths of a cell; index 0 is blank


def _bar(frac, color, width=28):
    """Track-less fill bar: a colored █ run plus one fractional cap, space-padded
    to `width` visible cells (padding stays uncolored so length math is trivial)."""
    frac = max(0.0, min(1.0, frac))
    filled = frac * width
    full = int(filled)
    cap = _EIGHTHS[int((filled - full) * 8)] if full < width else ""
    fill = "█" * full + cap
    return c(color, fill) + " " * (width - len(fill))


def _time_hint(s):
    tr = s["battery"].get("time_remaining_min")
    if not tr:
        return ""
    return f"~{tr}m to full" if s["battery_flow_w"] > 0.5 else f"~{tr}m left"


def _verdict(s):
    """(word, color) — the headline state."""
    flow, conn = s["battery_flow_w"], s["adapter"]["connected"]
    if not conn:
        return "On battery", "33"
    if flow < -0.5:
        return "Net drain", "31"
    if flow > 0.5:
        return "Net charge", "32"
    return "Balanced", "37"


# ledger geometry: indent(5) + label(8) + value(5) + gap(3) + bar(28) = 49 wide.
# The header's signed-watt value right-aligns to that same column 49.
_LEDGER_W, _BAR_W = 49, 28


def _header(word, col, flow):
    watts = f"{flow:+.1f} W"
    gap = max(2, _LEDGER_W - 5 - len(word) - len(watts))
    return f"  {c(col, '●')}  {c(col, word)}{' ' * gap}{c(col, watts)}"


def _row(label, value, unit, bar="", dim=False):
    """One ledger row: label, right-aligned value+unit, then its bar — all columns
    aligned. Padding is on visible text, so `bar`'s color codes never shift it."""
    # right-justify "value unit" as one token so a 2-char unit (GB) keeps the bar
    # column fixed. Identical to the old f"{value:>3.0f} {unit}" for W and %.
    lab, val = f"{label:<8}", f"{value:.0f} {unit}".rjust(5)
    if dim:
        lab, val = c("90", lab), c("90", val)
    return f"     {lab}{val}   {bar}".rstrip()


def _resource_rows(s):
    """gpu/cpu/ram rows, each on its OWN denominator (100%, installed RAM).

    Split from the watt ledger by a blank line: the two families share no scale,
    and adjacency without that gap would imply they are comparable.
    """
    g, h = s.get("gpu"), s.get("host")
    if not (g or h):
        return []
    total = s.get("ram_total_gb") or 0.0
    gb_bar = lambda v, col: _bar(v / total, col, _BAR_W) if total else ""
    rows = [""]
    if g:
        rows += [_row("gpu", g["util_pct"], "%", _bar(g["util_pct"] / 100, "32", _BAR_W)),
                 _row("gpu mem", g["mem_inuse_gb"], "GB", gb_bar(g["mem_inuse_gb"], "32"))]
    if h:
        rows += [_row("cpu", h["cpu_pct"], "%", _bar(h["cpu_pct"] / 100, "34", _BAR_W)),
                 _row("ram", h["ram_gb"], "GB", gb_bar(h["ram_gb"], "34"))]
    return rows


def _snapshot_lines(s):
    ad, bat = s["adapter"], s["battery"]
    flow, pull, deliver = s["battery_flow_w"], s["sys_power_w"], s["adapter_power_w"]
    word, col = _verdict(s)
    lines = ["", _header(word, col, flow), ""]  # leading blank + gap under header = air

    if not ad["connected"]:  # no rated ceiling to scale watt bars against → numbers only
        ctx = ([_time_hint(s)] if _time_hint(s) else []) + [f"{bat['temperature_c']:.0f}°C"]
        return lines + [_row("battery", bat["percent"], "%"),
                        _row("draw", pull, "W"),
                        "     " + c("90", " · ".join(ctx))] + _resource_rows(s)

    scale = max(ad["watts"], pull, deliver) or 1.0        # shared scale; rated = the ceiling
    return lines + [
        _row("battery", bat["percent"], "%"),             # a %, not watts → no bar in this column
        _row("draw", pull, "W", _bar(pull / scale, "33", _BAR_W)),
        _row("charger", deliver, "W", _bar(deliver / scale, "36", _BAR_W)),
        _row("rated", ad["watts"], "W", c("90", "░" * _BAR_W), dim=True),  # dim ceiling reference
    ] + _resource_rows(s)


def _status_line(s):
    """One-line form: non-TTY / pipe output (and, later, the live-plot footer)."""
    word, _ = _verdict(s)
    flow, pull, deliver = s["battery_flow_w"], s["sys_power_w"], s["adapter_power_w"]
    pct, rated = s["battery"]["percent"], s["adapter"]["watts"]
    hint = _time_hint(s)
    tail = f" · {hint}" if hint else ""
    if not s["adapter"]["connected"]:
        return f"on battery · {pct:.0f}% · {pull:.0f} W draw{tail}"
    if flow < -0.5:
        return (f"net drain {abs(flow):.1f} W · {pct:.0f}% · "
                f"draw {pull:.0f} W vs charger {deliver:.0f} W (rated {rated:.0f} W)")
    if flow > 0.5:
        return f"net charge {flow:.0f} W · {pct:.0f}% · charging{tail}"
    return f"balanced · {pct:.0f}% · draw {pull:.0f} W ≈ charger {deliver:.0f} W"


def snapshot(s):
    print("\n".join(_snapshot_lines(s)) if TTY else _status_line(s))


# ── braille chart (presentation, unchanged) ──────────────────────────────────────
# braille dot offsets by (row 0..3 top→bottom, column 0..1)
BRAILLE = [[0x01, 0x08], [0x02, 0x10], [0x04, 0x20], [0x40, 0x80]]
PANEL_H = 5  # chart cell rows per panel → 20 dot rows


def braille_chart(vals, color, width, height, y_min, y_max, ref=None):
    """One series on a braille canvas. Returns `height` rows of label(6)+chart(width)."""
    px_w, px_h = width * 2, height * 4
    bits = [[0] * width for _ in range(height)]
    cols = [[None] * width for _ in range(height)]
    span = (y_max - y_min) or 1.0

    def dot(px, py, dot_color):  # py measured from bottom
        if 0 <= px < px_w and 0 <= py < px_h:
            row = px_h - 1 - py
            bits[row // 4][px // 2] |= BRAILLE[row % 4][px % 2]
            cols[row // 4][px // 2] = dot_color

    def to_py(v):
        return round((v - y_min) / span * (px_h - 1))

    if ref is not None and y_min <= ref <= y_max:
        for px in range(0, px_w, 3):  # dashed reference line (e.g. PD contract)
            dot(px, to_py(ref), "90")
    pys = [to_py(v) for v in vals]
    for i, py in enumerate(pys):
        lo = min(py, pys[i - 1]) if i else py  # connect to previous sample
        hi = max(py, pys[i - 1]) if i else py
        for y in range(lo, hi + 1):
            dot(px_w - len(pys) + i, y, color)

    lines = []
    for r in range(height):
        y_here = y_max - (r + 0.5) / height * span
        label = f"{y_here:5.0f}┤" if r in (0, height - 1) else "     │"
        row = "".join(c(cols[r][x], chr(0x2800 + bits[r][x])) if bits[r][x]
                      else " " for x in range(width))
        lines.append(label + row)
    return lines


def panel(title, color, vals, width, y_min, y_max, ref=None, height=PANEL_H):
    """mactop-style bordered box: title in the frame, chart inside. No emoji in
    titles — terminals render them double-width and break border alignment."""
    inner = width + 6  # chart + y-axis labels
    head = f" {title} "
    top = "╭─" + c(color, head) + "─" * max(0, inner - len(head) - 1) + "╮"
    body = ["│" + row + "│" for row in
            braille_chart(vals, color, width, height, y_min, y_max, ref)]
    return [top] + body + ["╰" + "─" * inner + "╯"]


def side_by_side(*cols):
    """Join N equal-height panel blocks into one row of lines."""
    return [" ".join(parts) for parts in zip(*cols)]


# ── watch ────────────────────────────────────────────────────────────────────────
# Three groups, each laid out as its own band of panel rows. A group never shares
# a row with another group — that isolation is what makes the grouping readable.
GROUPS = (("energy", ("draw", "charger", "compute", "battery")),
          ("gpu", ("gpu", "gpu_mem")),
          ("system", ("cpu", "ram")))
LANES = tuple(lane for _, lanes in GROUPS for lane in lanes)
PER_ROW = 2          # always 2 wide: keeps charts readable at any terminal size
COMPACT_H = 2        # one deliberate density step, not a gradual squeeze


def _chunk(lanes, per_row=PER_ROW):
    """Split one group's lanes into panel rows."""
    return [list(lanes[i:i + per_row]) for i in range(0, len(lanes), per_row)]


def sleep_remainder(started, interval_ms, clock=time.monotonic, sleep=time.sleep):
    """Sleep only what is left of the interval, so the period IS the interval.

    Sleeping the full interval after doing the work makes the real period
    work+interval: measured 2074ms against a 2000ms target over 291 samples.
    """
    left = interval_ms / 1000 - (clock() - started)
    if left > 0:
        sleep(left)
    return max(0.0, left)


def grid_rows(groups=GROUPS, per_row=PER_ROW, sep=False):
    """Flatten groups into panel rows, never mixing two groups in one row.

    sep=True inserts None between groups, rendered as a blank line — the same
    device the snapshot uses to separate its watt ledger from the gpu/cpu rows.
    """
    rows = []
    for _, lanes in groups:
        if sep and rows:
            rows.append(None)
        rows += _chunk(lanes, per_row)
    return rows


def group_caption(name, s):
    """Group-scoped state, shown under its own band rather than in the footer.

    The footer carries only what every facet shares (sample count, interval,
    clock); the PD contract and battery charge describe the energy band alone.
    """
    if name != "energy":
        return None
    ad, bat = s["adapter"], s["battery"]
    state = f"rated {ad['watts']}W ┄" if ad["connected"] else "ON BATTERY"
    return f" {state} · batt {bat['percent']:.0f}%"


def lane_panel(lane, vals, width, height, rated, total_gb):
    """One lane rendered as a bordered chart, with its own correctly-bounded axis."""
    label, fmt, ref = LANE_META[lane]
    color = ("32" if vals[-1] >= 0 else "31") if lane == "battery" else COLORS[lane]
    ref = rated if ref == "rated" else ref
    lo, hi = lane_scale(lane, vals, hi_floor=ref if lane in ("draw", "charger") else None,
                        total_gb=total_gb)
    return panel(f"{label} {fmt.format(vals[-1])}", color, vals, width, lo, hi,
                 ref=ref, height=height)


def panel_geom(cols, lines, n_rows, per_row=PER_ROW, extra_lines=1):
    """(chart width, chart height). Width generalizes today's (cols - 2*9)//2.

    `extra_lines` counts every non-panel line in the frame — group separators,
    group captions, the footer. They spend height too, so the compact step has
    to include them or it trips at the wrong terminal size.
    """
    width = max(24, min(80, (cols - 9 * per_row) // per_row))
    full = n_rows * (PANEL_H + 2) + extra_lines <= lines
    return width, (PANEL_H if full else COMPACT_H)


def watch(seconds, interval_ms, log_path=None):
    try:
        smc = SMC()
    except OSError as e:
        sys.exit(f"pdraw: cannot read power — {e}")
    logf = open(log_path, "a") if log_path else None  # JSONL, one sample per line
    host = host_or_none()
    bat_cache = BatteryCache()   # the gauge moves every ~35s; don't fork ioreg per tick
    term = shutil.get_terminal_size()
    _rows = grid_rows(sep=True)
    _blanks = _rows.count(None)
    width, panel_h = panel_geom(term.columns, term.lines, len(_rows) - _blanks,
                                extra_lines=_blanks + 2)  # + energy caption + footer
    hist = {k: deque(maxlen=width * 2) for k in LANES}
    start, frame = time.monotonic(), []

    def _on_term(*_):  # `kill` would skip the finally and strand the terminal in
        raise KeyboardInterrupt  # the alt-screen; reroute it through the same teardown

    if TTY:  # run inside the alternate screen buffer, like mactop/htop: the live
        signal.signal(signal.SIGTERM, _on_term)  # view is ephemeral, restored on exit
        sys.stdout.write("\x1b[?1049h\x1b[?25l")  # enter alt-screen, hide cursor
        sys.stdout.flush()
    try:
        while True:
            tick = time.monotonic()
            s = read_sample(smc, host, bat_cache)
            if logf:  # append + flush per line: tail-able live, kill loses at most one line
                logf.write(json.dumps({**s, "t": time.time()}, separators=(",", ":")) + "\n")
                logf.flush()
            groups = active_groups(s)  # absent groups are dropped, never drawn empty
            caps = {n: group_caption(n, s) for n, _ in groups}
            n_rows = sum(len(_chunk(lanes)) for _, lanes in groups)
            extra = (len(groups) - 1) + sum(1 for v in caps.values() if v) + 1
            term = shutil.get_terminal_size()
            w, panel_h = panel_geom(term.columns, term.lines, n_rows,
                                    extra_lines=extra)
            if w != width:  # terminal resized: re-flow panels, re-cap history to fit
                width = w   # deque(old, maxlen=n) keeps the most recent n samples
                hist = {k: deque(hist[k], maxlen=width * 2) for k in LANES}
            for k, v in lane_values(s).items():
                hist[k].append(v)
            ad = s["adapter"]          # battery % moved into the energy caption
            rated = ad["watts"] if ad["connected"] else None
            total_gb = host.total_gb if host else 0.0
            frame = []
            for gi, (name, lanes) in enumerate(groups):
                if gi:
                    frame.append("")          # blank line divides the groups
                for row in _chunk(lanes):
                    frame += side_by_side(*(lane_panel(k, hist[k], width, panel_h,
                                                       rated, total_gb) for k in row))
                if caps[name]:                # group-scoped state, under its band
                    frame.append(caps[name])
            # frame-scoped state: every facet shares one cadence and one clock
            foot = (f" {len(hist['draw'])} samples @ {interval_ms}ms · "
                    f"{time.strftime('%H:%M:%S')}")
            frame.append(foot)
            if TTY:  # redraw from home + clear-to-end: resilient to resize/clear,
                sys.stdout.write(  # no prev_lines bookkeeping to drift out of sync
                    "\x1b[H" + "\n".join(l + "\x1b[K" for l in frame) + "\x1b[J")
                sys.stdout.flush()
            if seconds and time.monotonic() - start >= seconds:
                break
            sleep_remainder(tick, interval_ms)
    except KeyboardInterrupt:
        pass
    finally:
        if TTY:  # always restore — Ctrl-C, -w timeout, SIGTERM, or error
            sys.stdout.write("\x1b[?25h\x1b[?1049l")  # show cursor, leave alt-screen
            sys.stdout.flush()
        if logf:
            logf.close()
    if not TTY and frame:  # piped/captured: residue is the point — keep the record
        print("\n".join(frame))
        if hist["draw"]:
            n = len(hist["draw"])
            print(f"— {n} samples · draw avg {sum(hist['draw'])/n:.1f}W · "
                  f"battery net {sum(hist['battery'])/len(hist['battery']):+.1f}W")


# ── procs: per-process view ─────────────────────────────────────────────────────
# CPU, memory, names and the pid list all come from libproc with no sudo. Only
# IMPACT needs powermetrics as root, so it is opt-in (--energy) rather than a
# toll everyone pays: one column's requirement should not be the view's.
def procs_lines(rows, gpu, s, view=12, off=0, sort_key="cpu_pct", reverse=True,
                show_energy=False):
    """Header of global state, then a sorted, scrollable window of processes."""
    bits = []
    if gpu:
        bits += [f"GPU {gpu['util_pct']:.0f}%", f"gpu mem {gpu['mem_inuse_gb']:.1f} GB"]
    bits.append(f"{s['sys_power_w']:.0f} W draw")
    head = ["", f"  {c('32', '●')}  " + " · ".join(bits), ""]
    if not rows:
        return head + ["     no readable processes"]
    ordered = sort_rows(rows, sort_key, reverse)
    window = ordered[off:off + view]
    shown = f"{off + 1}-{off + len(window)} of {len(ordered)}" if window else "none"
    keys = "c/m/p/n" + ("/e" if show_energy else "")
    nav = f" · jk/↑↓ scroll · {keys} sort (again to flip) · q quit"
    return (head + proc_table(window, sort_key, reverse, show_energy=show_energy)
            + ["     " + c("90", shown + nav)])


def procs(seconds, interval_ms, want_energy=False):
    """Live per-process view.

    Ranked by CPU by default. With --energy it also shows Apple's Energy Impact
    score, which is the only per-process signal that moves when work shifts to
    the GPU -- macOS exposes no per-process GPU or VRAM on Apple Silicon at all.
    """
    try:
        smc = SMC()
    except OSError as e:
        sys.exit(f"pdraw: cannot read power — {e}")
    host, bat_cache, source = host_or_none(), BatteryCache(), Processes()
    pm, quiet = None, True
    have_pm = bool(shutil.which("powermetrics"))
    if want_energy and not have_pm:
        sys.exit("pdraw: powermetrics not found (it ships with macOS)")
    # Free upgrade: if sudo needs no password right now (cached credential or a
    # NOPASSWD rule), show IMPACT without being asked. Only an actual prompt is
    # worth making someone opt in to.
    if have_pm and (want_energy or sudo_passwordless(PowerMetrics.argv())):
        # Prime sudo BEFORE the alt-screen: the prompt must land on the real
        # screen, and caching lets the child's noisy stderr be silenced.
        quiet = sudo_prime(PowerMetrics.argv())
        if not quiet:
            print("pdraw: sudo not cached — powermetrics warnings will show.")
        pm = PowerMetrics(quiet=quiet)
    show_energy = pm is not None

    def _on_term(*_):
        raise KeyboardInterrupt

    keys = None
    off, start, frame, done = 0, time.monotonic(), [], False
    sort_key, reverse = ("energy" if show_energy else "cpu_pct"), True
    source.sample()          # CPU is a delta; discard the baseline sample

    def view_rows():
        return max(3, shutil.get_terminal_size().lines - 10)

    def render(rows, sample):
        out = procs_lines(rows, sample.get("gpu"), sample, view_rows(), off,
                          sort_key, reverse, show_energy=show_energy)
        hint = ("IMPACT is a relative score, not watts · " if show_energy
                else "IMPACT (energy) needs --energy · ")
        note = (f"     {hint}no per-process GPU on Apple Silicon · "
                f"{time.strftime('%H:%M:%S')}")
        out += ["", c("90", note)]
        if TTY:
            sys.stdout.write("\x1b[H" + "\n".join(l + "\x1b[K" for l in out) + "\x1b[J")
            sys.stdout.flush()
        return out

    try:
        if TTY:
            signal.signal(signal.SIGTERM, _on_term)
            # cbreak inside the try: an exception before the guard would
            # otherwise strand the terminal with no echo and no line editing
            if sys.stdin.isatty():
                keys = KeyReader()
            sys.stdout.write("\x1b[?1049h\x1b[?25l")
            sys.stdout.flush()
        while not done:
            tick = time.monotonic()
            sample = read_sample(smc, host, bat_cache)
            rows = source.sample()
            if pm:
                rows = merge_energy(rows, pm.poll())
            frame = render(rows, sample)
            # poll keys far faster than we sample: navigation that lagged a whole
            # refresh would feel broken
            while time.monotonic() - tick < interval_ms / 1000:
                if keys:
                    acts = parse_keys(keys.pending())
                    if "quit" in acts:
                        done = True
                        break
                    if acts:
                        for a in acts:
                            if a == "reverse":
                                reverse = not reverse
                            elif a in SORT_KEYS:
                                if SORT_KEYS[a] == "energy" and not show_energy:
                                    continue          # column isn't shown
                                sort_key, reverse = next_sort(sort_key, reverse, a)
                                off = 0               # new ordering starts at its top
                            else:
                                off = scroll_clamp(off, a, len(rows), view_rows())
                        frame = render(rows, sample)
                if seconds and time.monotonic() - start >= seconds:
                    done = True
                    break
                time.sleep(0.05)
    except KeyboardInterrupt:
        pass
    finally:
        if keys:
            keys.restore()      # never leave the terminal in cbreak mode
        if TTY:
            sys.stdout.write("\x1b[?25h\x1b[?1049l")
            sys.stdout.flush()
        left = pm.close() if pm else None
        if left:   # root-owned survivor we cannot kill ourselves — say so
            print(f"pdraw: powermetrics still running as root (pid {' '.join(left)}); "
                  f"stop it with: sudo kill {' '.join(left)}")
    if not TTY and frame:
        print("\n".join(frame))


